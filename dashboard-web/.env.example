# ─── Authentication (Clerk) ───────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Get these from https://app.supabase.com → your project → Settings → API
SUPABASE_URL=
# Use the service_role key (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public URL alias (same value as SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: override the default storage bucket name (default: career-ops-files)
SUPABASE_STORAGE_BUCKET=career-ops-files

# ─── Tenant / hosting mode ────────────────────────────────────────────────────
# local-dev  → filesystem, no auth required (default)
# hosted     → Supabase storage + Clerk auth required
CAREER_OPS_TENANT_MODE=local-dev

# ─── Local dev overrides ──────────────────────────────────────────────────────
# Override the path where career-ops data lives (defaults to repo root)
CAREER_OPS_PATH=
# Pin a single tenant ID in local/env mode (skips Clerk auth)
CAREER_OPS_TENANT_ID=
# Allow x-tenant-id header in production (dangerous — leave false)
CAREER_OPS_ALLOW_DEV_TENANT_HEADER=false

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4001
DASHBOARD_URL=http://localhost:4001

# ─── Background worker (hosted mode) ─────────────────────────────────────────
# Run separately: npm run worker  (or npm run worker:once for a single claim)
# Requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY — worker exits without them.
WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_STALE_SECONDS=900
